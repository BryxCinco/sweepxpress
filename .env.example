# Copy this file to .env and fill in real values. Never commit .env.
APP_URL=http://localhost/sweepxpress
APP_ENV=local

# Database — puwedeng iwanang wala sa local XAMPP (default: localhost/sweepxpress_db/root/walang password)
DB_HOST=localhost
DB_NAME=sweepxpress_db
DB_USER=root
DB_PASS=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_APP_PASSWORD=changeme
MAIL_FROM_NAME=SweepXpress

# Admin Copilot (Groq). Kumuha ng libreng key sa https://console.groq.com. Walang key = nakatago ang copilot.
GROQ_API_KEY=
# Dapat nasa listahan ng console.groq.com/docs/models (nagbabago; ang lumang llama ay tinanggal na). Subukan: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b
# Limit ng tanong: bawat admin kada minuto, bawat admin kada araw, at lahat ng admin kada araw.
# Ang libreng tier ng Groq ay ~8,000 token kada minuto (mga 2-3 tanong), kaya 3 ang kada minuto.
COPILOT_MINUTE_LIMIT=3
COPILOT_DAILY_LIMIT=100
COPILOT_GLOBAL_DAILY_LIMIT=300
